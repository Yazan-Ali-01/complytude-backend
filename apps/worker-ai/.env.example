# ============================================
# Worker AI Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=worker-ai   # Identifies this service in structured logs

# Worker AI Port
WORKER_AI_PORT=3001

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:

# Queue Configuration
WORKER_AI_CONCURRENCY=5
WORKER_AI_MAX_RETRIES=3
WORKER_AI_RETRY_DELAY=5000

# Processing Limits
WORKER_AI_MAX_PROCESSING_TIME=300000

# OpenAI Configuration (shared key for embeddings + LLM)
OPENAI_API_KEY=your-openai-api-key-here
# OpenAI host, shared by embeddings and chat. Only https://api.openai.com/v1 or a data-residency
# host is accepted: https://us.api.openai.com/v1, https://eu.api.openai.com/v1, https://ae.api.openai.com/v1
# (a residency host needs a project approved for it by OpenAI; worker-ai and worker-ingestion must match)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Embedding Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_RETRIES=3
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=50

# OpenAI Chat (LLM) Configuration
OPENAI_CHAT_MODEL=gpt-4o-mini
# Required when OPENAI_CHAT_MODEL isn't in the known table (apps/worker-ai/src/config/chat-model.ts)
# OPENAI_CHAT_CONTEXT_WINDOW=400000
# Output tokens; reasoning models count their reasoning tokens against it
OPENAI_CHAT_MAX_TOKENS=4096
# Unset: 0.1 for a known model, none sent for any other (reasoning models reject it)
OPENAI_CHAT_TEMPERATURE=0.1
OPENAI_CHAT_TIMEOUT=120000

# Cohere Re-ranking Configuration
COHERE_API_KEY=your-cohere-api-key-here
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=25

# RAG Retrieval Tuning
RAG_TOP_K_PER_QUERY=5
RAG_VECTOR_LIMIT=30
RAG_BM25_LIMIT=30
RAG_MAX_HYBRID_RESULTS=40

# Resource Limits (for Kubernetes/Docker)
WORKER_AI_MEMORY_LIMIT=2GB
WORKER_AI_CPU_LIMIT=2

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_APP_USER=postgres
DB_APP_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
# Postgres ends a statement running longer than this, and a transaction left idle this long (ms)
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT=30000
# TLS to the database: required and verified in production. On AWS, DB_SSL_CA_PATH points at the
# Amazon RDS CA bundle baked into the image (/app/certs/rds-global-bundle.pem)
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=
