# ============================================
# Worker AI Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Worker AI Port
WORKER_AI_PORT=3001

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Configuration
WORKER_AI_QUEUE_NAME=ai-processing-queue
WORKER_AI_CONCURRENCY=5
WORKER_AI_MAX_RETRIES=3
WORKER_AI_RETRY_DELAY=5000

# Processing Limits
WORKER_AI_MAX_PROCESSING_TIME=300000
WORKER_AI_BATCH_SIZE=10

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=60000
AI_SERVICE_API_KEY=your-ai-service-api-key-here

# Resource Limits (for Kubernetes/Docker)
WORKER_AI_MEMORY_LIMIT=2GB
WORKER_AI_CPU_LIMIT=2

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
