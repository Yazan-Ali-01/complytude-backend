# ============================================
# Worker Ingestion Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=worker-ingestion  # Identifies this service in structured logs

# Worker Ingestion Port
WORKER_INGESTION_PORT=3002

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:

# Worker Processing Configuration
WORKER_INGESTION_CONCURRENCY=10
WORKER_INGESTION_MAX_RETRIES=3
WORKER_INGESTION_RETRY_DELAY=3000
WORKER_INGESTION_MAX_PROCESSING_TIME=180000
WORKER_INGESTION_BATCH_SIZE=500

# Resource Limits (for Kubernetes/Docker)
WORKER_INGESTION_MEMORY_LIMIT=1GB
WORKER_INGESTION_CPU_LIMIT=1

# OpenAI Embedding Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_RETRIES=3
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=50

COHERE_API_KEY=cydXtAvvms2cWlRtx3Q6A35hew1iRgcJKJDuvj04
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=10

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_APP_USER=postgres
DB_APP_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000


# S3 Storage — For AWS: leave S3_ENDPOINT empty, use IAM roles or set S3_ACCESS_KEY/S3_SECRET_KEY.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
COMPLYTUDE_FILES_BUCKET_NAME=complytude-staging-clean
TEMPLATES_BUCKET_NAME=complytude-staging-clean
QUARANTINE_BUCKET_NAME=complytude-staging-quarantine
MAX_FILE_SIZE=10485760
TEMPLATE_MAX_FILE_SIZE=5242880
SIGNED_URL_EXPIRES_IN=900

# Textract (document text extraction)
# Uses the same AWS region as S3_REGION and ECS task role credentials in production.
# For local dev, uses S3_ACCESS_KEY/S3_SECRET_KEY (developer IAM user with Textract permissions).
TEXTRACT_MAX_PAGES=50
TEXTRACT_POLL_INITIAL_DELAY_MS=2000
TEXTRACT_POLL_MAX_DELAY_MS=30000
TEXTRACT_POLL_MAX_ATTEMPTS=60
TEXTRACT_POLL_BACKOFF_MULTIPLIER=1.5
