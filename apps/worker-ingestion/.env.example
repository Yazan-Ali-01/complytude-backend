# ============================================
# Worker Ingestion Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Worker Ingestion Port
WORKER_INGESTION_PORT=3002

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Configuration
WORKER_INGESTION_QUEUE_NAME=data-ingestion-queue
WORKER_INGESTION_CONCURRENCY=10
WORKER_INGESTION_MAX_RETRIES=3
WORKER_INGESTION_RETRY_DELAY=3000

# Processing Limits
WORKER_INGESTION_MAX_PROCESSING_TIME=180000
WORKER_INGESTION_BATCH_SIZE=50

# File Processing Configuration
WORKER_INGESTION_MAX_FILE_SIZE=52428800
WORKER_INGESTION_ALLOWED_FILE_TYPES=pdf,docx,xlsx,csv

# Storage Configuration
WORKER_INGESTION_STORAGE_TYPE=s3
WORKER_INGESTION_STORAGE_PATH=/tmp/ingestion

# Resource Limits (for Kubernetes/Docker)
WORKER_INGESTION_MEMORY_LIMIT=1GB
WORKER_INGESTION_CPU_LIMIT=1

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
