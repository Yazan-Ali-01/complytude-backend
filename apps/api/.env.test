# ============================================
# Test Environment Variables
# ============================================
# Used by Jest integration tests.
# Committed to repo — no real secrets here.
#
# DB_HOST / DB_PORT / DB_NAME / DB_APP_USER / DB_APP_PASSWORD and
# REDIS_HOST / REDIS_PORT are placeholders — COM-140's globalSetup
# overrides them at runtime via testcontainers before the app boots.

# Application
NODE_ENV=test
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001
ENTITLEMENT_STRICT_THRESHOLD_PERCENT=5

# Database — overridden at runtime by testcontainers (COM-140)
DB_HOST=placeholder
DB_PORT=5432
DB_NAME=placeholder
DB_APP_USER=placeholder
DB_APP_PASSWORD=placeholder
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=5000

# Redis — overridden at runtime by testcontainers (COM-140)
REDIS_HOST=placeholder
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:test:

# JWT — dummy secrets, safe to commit
JWT_ACCESS_SECRET=test-jwt-access-secret-not-for-production
JWT_REFRESH_SECRET=test-jwt-refresh-secret-not-for-production
JWT_IDENTITY_SECRET=test-jwt-identity-secret-not-for-production
JWT_IDENTITY_REFRESH_SECRET=test-jwt-identity-refresh-secret-not-for-production
JWT_REFRESH_HASH_SECRET=test-jwt-refresh-hash-secret-not-for-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d
JWT_IDENTITY_EXPIRES_IN=10m
JWT_IDENTITY_REFRESH_EXPIRES_IN=14d
EMAIL_VERIFICATION_EXPIRES_IN=1d

# S3/MinIO — dummy values; tests mock storage or use a test container.
# App uses COMPLYTUDE_FILES_BUCKET_NAME and TEMPLATES_BUCKET_NAME (not S3_BUCKET_PREFIX).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=test-access-key
S3_SECRET_KEY=test-secret-key
S3_FORCE_PATH_STYLE=true
COMPLYTUDE_FILES_BUCKET_NAME=complytude-files-test
TEMPLATES_BUCKET_NAME=complytude-templates-test
MAX_FILE_SIZE=10485760
TEMPLATE_MAX_FILE_SIZE=5242880
SIGNED_URL_EXPIRES_IN=900
