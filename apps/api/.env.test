# ============================================
# Test Environment Variables
# ============================================
# Keep variable names in sync with env.schema.ts (source of truth).
# .env.example may be outdated — validate against the schema.
#
# DB_* and REDIS_HOST/REDIS_PORT are placeholders — COM-140's globalSetup
# overrides them at runtime via testcontainers before the app boots.

# Application
NODE_ENV=test
# Tests read verification and reset tokens from the signup / forgot-password responses
AUTH_ECHO_TOKENS=true
# Most tests log in many times; the limiter's own tests turn it on
RATE_LIMIT_ENABLED=false
# As behind the ALB: the right-most X-Forwarded-For entry is the client
TRUST_PROXY_HOPS=1
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001
ENTITLEMENT_STRICT_THRESHOLD_PERCENT=5

# Database — overridden at runtime by testcontainers (COM-140)
DB_HOST=placeholder
DB_PORT=5432
DB_NAME=placeholder
DB_APP_USER=placeholder
DB_APP_PASSWORD=placeholder
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=5000
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_ACCESS_SECRET=test-jwt-access-secret-not-for-production
JWT_REFRESH_SECRET=test-jwt-refresh-secret-not-for-production
JWT_IDENTITY_SECRET=test-jwt-identity-secret-not-for-production
JWT_IDENTITY_REFRESH_SECRET=test-jwt-identity-refresh-secret-not-for-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_IDENTITY_EXPIRES_IN=10m
EMAIL_VERIFICATION_EXPIRES_IN=1d

# Short TTLs for faster integration test cycles (session expiry / idle scenarios)
SESSION_MAX_TTL=60s
SESSION_IDLE_TIMEOUT=30s
SESSION_MAX_PER_USER=5
SESSION_ACTIVITY_THROTTLE_SECONDS=120

# MaxMind GeoIP (optional — empty = geo disabled)
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Email (log-only in tests)
FRONTEND_URL=http://localhost:3001
EMAIL_SKIP_SEND=true
AWS_REGION=eu-central-1
FROM_EMAIL=noreply@example.com
FROM_NAME=Complytude Test
SUPPORT_EMAIL=support@example.com

# Stripe — non-empty required by env validation; not used when billing is skipped in tests
STRIPE_SECRET_KEY=sk_test_integration_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_integration_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_integration_placeholder


# S3 Storage
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
COMPLYTUDE_FILES_BUCKET_NAME=complytude-staging-clean
TEMPLATES_BUCKET_NAME=complytude-staging-clean
QUARANTINE_BUCKET_NAME=complytude-staging-quarantine
MAX_FILE_SIZE=10485760
TEMPLATE_MAX_FILE_SIZE=5242880
SIGNED_URL_EXPIRES_IN=900

# Redis — overridden at runtime by testcontainers (COM-140)
REDIS_HOST=placeholder
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:test:
