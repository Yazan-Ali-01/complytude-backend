# ============================================
# API Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
# Mount the dev-only demo routes (/mock/*, /admin/queue-test/*, /rag-mock/*). Local use only:
# they are never mounted when NODE_ENV=production, and setting this to true there fails boot.
ENABLE_MOCK_ROUTES=false
# Return the verification / reset token in the signup and forgot-password responses (tests and
# local development only). Setting it to true with NODE_ENV=production fails boot.
AUTH_ECHO_TOKENS=false
# Refuse new passwords (signup, reset, change) found in data breaches, via the Have I Been Pwned
# range API (only 5 characters of the password's SHA-1 are sent). Accepts the password if the
# service can't be reached.
PASSWORD_BREACH_CHECK_ENABLED=true
# Redis-backed request limits and login lockout; can't be turned off with NODE_ENV=production
RATE_LIMIT_ENABLED=true
# Proxies whose X-Forwarded-For entries give the client IP: 0 locally, 1 behind the ALB (required in production)
TRUST_PROXY_HOPS=0

# Logging
LOG_LEVEL=debug          # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=gateway     # Identifies this service in structured logs
PORT=3000
API_PREFIX=api
# Web app origins, comma-separated (spaces and a trailing slash are fine); https only in production.
# Also the allowlist for Stripe checkout/portal return URLs.
CORS_ORIGINS=http://localhost:3000

# Entitlement caching configuration
# Subscription cache TTL in seconds (10-3600, default: 60)
# Feature cache TTL in seconds (30-7200, default: 300)
# Cache cleanup interval in seconds (60-3600, default: 300)

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=complytude
# Admin/Superuser credentials (for setup and migrations)
DB_USER=postgres
DB_PASSWORD=postgres
# Application user credentials
DB_APP_USER=app_login
DB_APP_PASSWORD=your_secure_password_here
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
# Postgres ends a statement running longer than this, and a transaction left idle this long (ms)
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT=30000
# TLS to the database: required and verified in production. On AWS, DB_SSL_CA_PATH points at the
# Amazon RDS CA bundle baked into the image (/app/certs/rds-global-bundle.pem)
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# cache, sessions, rate limiting
REDIS_DB=0
# BullMQ job queues (separate DB to prevent FLUSHDB wiping jobs)
REDIS_QUEUE_DB=1

# JWT Authentication
# JWT: four different secrets; with NODE_ENV=production each must be 32+ characters and not a
# placeholder like these (openssl rand -hex 32)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_IDENTITY_SECRET=your-super-secret-jwt-identity-key-change-this-in-production
JWT_IDENTITY_REFRESH_SECRET=your-super-secret-jwt-identity-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_IDENTITY_EXPIRES_IN=10m
EMAIL_VERIFICATION_EXPIRES_IN=1d

# MaxMind GeoLite2-City (optional — empty path or no file = geo disabled). Locally:
#   MAXMIND_LICENSE_KEY=your_key ./scripts/download-geolite2-city.sh
# (key: https://www.maxmind.com/en/accounts/current/license-key). Images download it at build time.
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Session (Redis-backed) — also sets identity + tenant refresh JWT expiry (jwt.refreshExpiresIn)
SESSION_MAX_TTL=14d
SESSION_IDLE_TIMEOUT=72h
SESSION_MAX_PER_USER=5
SESSION_ACTIVITY_THROTTLE_SECONDS=120

# The web app: email links (verify, reset, invite, upgrade) and SSO redirects point here.
# Required, and must be https, when NODE_ENV=production.
FRONTEND_URL=http://localhost:3000

# Skip real SES calls (local / tests)
EMAIL_SKIP_SEND=false

# Stripe (billing)
STRIPE_SECRET_KEY=


# S3 Storage — For AWS: leave S3_ENDPOINT empty, use IAM roles or set S3_ACCESS_KEY/S3_SECRET_KEY.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
COMPLYTUDE_FILES_BUCKET_NAME=complytude-staging-clean
TEMPLATES_BUCKET_NAME=complytude-staging-clean
QUARANTINE_BUCKET_NAME=complytude-staging-quarantine
MAX_FILE_SIZE=10485760
TEMPLATE_MAX_FILE_SIZE=5242880
# Most pages an uploaded PDF may have (OCR bills per page); same value as worker-ingestion
DOCUMENT_MAX_PAGES=50

# Activate a ruleset version only once its legal review is recorded (always true in production)
RULESETS_REQUIRE_REVIEW=false

# Document previews a tenant may request per day (UTC): each is a conversion on the generation worker
PREVIEW_DAILY_LIMIT=50

SIGNED_URL_EXPIRES_IN=900

# Stripe
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Run `stripe listen --forward-to localhost:3000/api/stripe/webhook` for local webhook testing
# test or live: the keys must belong to that mode, and webhook events of the other mode are
# refused. Required when NODE_ENV=production.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Syncs catalog (products/prices) to Stripe on every startup
STRIPE_CATALOG_SYNC_ENABLED=false
# Enables Stripe Tax: syncs UAE address + TRN to customers for automatic VAT calculation
# Requires Stripe Tax to be enabled in the Stripe dashboard first
STRIPE_TAX_ENABLED=false

# Billing Scheduler
# Enables scheduled billing jobs (daily Stripe reconciliation at 3 AM)
# Automatically enabled in production, set to true to enable in development
BILLING_SCHEDULE_ENABLED=false

# OAuth2 SSO (optional — leave empty to disable; all three required per provider to enable)
# Callback URLs must match Google / Azure app registration (include /api/v1 prefix).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=common
# After OAuth, browser is sent to FRONTEND_URL + path (defaults below)
SSO_FRONTEND_SUCCESS_PATH=/auth/callback
SSO_FRONTEND_ERROR_PATH=/auth/error

# Bull Board (/admin/queues) — served on its own port, never on the public API port (PORT)
# BULL_BOARD_ADMIN_SECRET: required when NODE_ENV=production, at least 32 characters (openssl rand -hex 32).
#   When set, the dashboard listens on 0.0.0.0 and requests need Authorization: Bearer <secret>,
#   X-Admin-Secret: <secret>, or HTTP Basic auth with the secret as the password (any username).
#   Leave unset in local development: the dashboard is then open but bound to 127.0.0.1 only.
# BULL_BOARD_ADMIN_SECRET=
BULL_BOARD_PORT=3010

# Email — AWS SES (SDK default credential chain: AWS_ACCESS_KEY_ID / IAM role, etc.)
# Sandbox: verify sender and recipient in the SES console, or use EMAIL_SKIP_SEND=true locally
AWS_REGION=eu-central-1
FROM_EMAIL=billing@your-domain.com
FROM_NAME="Your Company Billing"
SUPPORT_EMAIL=support@your-domain.com
# SES configuration set every send names (bounce/complaint events, reputation metrics); Terraform
# creates it (<project>-<environment>). Empty locally.
SES_CONFIGURATION_SET=

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@complytude.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
