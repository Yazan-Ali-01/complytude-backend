# ============================================
# API Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=gateway     # Identifies this service in structured logs
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Percent of quota where strict CAS enforcement kicks in (1-50)
ENTITLEMENT_STRICT_THRESHOLD_PERCENT=5

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=complytude
# Admin/Superuser credentials (for setup and migrations)
DB_USER=postgres
DB_PASSWORD=postgres
# Application user credentials
DB_APP_USER=app_login
DB_APP_PASSWORD=your_secure_password_here
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# cache, sessions, rate limiting
REDIS_DB=0
# BullMQ job queues (separate DB to prevent FLUSHDB wiping jobs)
REDIS_QUEUE_DB=1

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_REFRESH_HASH_SECRET=your-super-secret-jwt-refresh-hash-key-change-this-in-production
JWT_IDENTITY_SECRET=your-super-secret-jwt-identity-key-change-this-in-production
JWT_IDENTITY_REFRESH_SECRET=your-super-secret-jwt-identity-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d
JWT_IDENTITY_EXPIRES_IN=10m
EMAIL_VERIFICATION_EXPIRES_IN=1d

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
# Set to true to log emails instead of sending (useful for development)
EMAIL_SKIP_SEND=false

# Stripe (billing)
STRIPE_SECRET_KEY=
# Set to true to skip Stripe customer creation (useful when Stripe not configured)
STRIPE_SKIP_CUSTOMER_CREATION=false

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PREFIX=complytude
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=10485760
SIGNED_URL_EXPIRES_IN=900

# MinIO (Docker)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@complytude.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
