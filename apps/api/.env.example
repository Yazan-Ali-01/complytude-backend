# ============================================
# API Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=gateway     # Identifies this service in structured logs
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Percent of quota where strict CAS enforcement kicks in (1-50)
ENTITLEMENT_STRICT_THRESHOLD_PERCENT=5

# Entitlement caching configuration
# Subscription cache TTL in seconds (10-3600, default: 60)
ENTITLEMENT_SUBSCRIPTION_CACHE_TTL_SECONDS=60
# Feature cache TTL in seconds (30-7200, default: 300)
ENTITLEMENT_FEATURE_CACHE_TTL_SECONDS=300
# Cache cleanup interval in seconds (60-3600, default: 300)
ENTITLEMENT_CACHE_CLEANUP_INTERVAL_SECONDS=300

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=complytude
# Admin/Superuser credentials (for setup and migrations)
DB_USER=postgres
DB_PASSWORD=postgres
# Application user credentials
DB_APP_USER=app_login
DB_APP_PASSWORD=your_secure_password_here
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# cache, sessions, rate limiting
REDIS_DB=0
# BullMQ job queues (separate DB to prevent FLUSHDB wiping jobs)
REDIS_QUEUE_DB=1

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_IDENTITY_SECRET=your-super-secret-jwt-identity-key-change-this-in-production
JWT_IDENTITY_REFRESH_SECRET=your-super-secret-jwt-identity-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_IDENTITY_EXPIRES_IN=10m
EMAIL_VERIFICATION_EXPIRES_IN=1d

# MaxMind GeoIP (optional — empty = geo disabled)
# Get license key: https://www.maxmind.com/en/accounts/current/license-key
# Run: MAXMIND_LICENSE_KEY=your_key ./scripts/download-geolite2-city.sh
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Session (Redis-backed) — also sets identity + tenant refresh JWT expiry (jwt.refreshExpiresIn)
SESSION_MAX_TTL=14d
SESSION_IDLE_TIMEOUT=72h
SESSION_MAX_PER_USER=5
SESSION_ACTIVITY_THROTTLE_SECONDS=120

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Skip real SES calls (local / tests); verification links still appear in non-prod API responses where applicable
EMAIL_SKIP_SEND=false

# Stripe (billing)
STRIPE_SECRET_KEY=
# Set to true to skip Stripe customer creation (useful when Stripe not configured)
STRIPE_SKIP_CUSTOMER_CREATION=false

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PREFIX=complytude
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=10485760
SIGNED_URL_EXPIRES_IN=900

# MinIO (Docker)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Stripe
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Run `stripe listen --forward-to localhost:3000/api/stripe/webhook` for local webhook testing
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Syncs catalog (products/prices) to Stripe on every startup
STRIPE_CATALOG_SYNC_ENABLED=false
# Enables Stripe Tax: syncs UAE address + TRN to customers for automatic VAT calculation
# Requires Stripe Tax to be enabled in the Stripe dashboard first
STRIPE_TAX_ENABLED=false

# Billing Scheduler
# Enables scheduled billing jobs (daily Stripe reconciliation at 3 AM)
# Automatically enabled in production, set to true to enable in development
BILLING_SCHEDULE_ENABLED=false

# Bull Board (/admin/queues) — optional in dev, required in production
# When set, requests must include: Authorization: Bearer <secret> or X-Admin-Secret: <secret>
# Omit in development for unauthenticated access
# BULL_BOARD_ADMIN_SECRET=

# Email — AWS SES (SDK default credential chain: AWS_ACCESS_KEY_ID / IAM role, etc.)
# Sandbox: verify sender and recipient in the SES console, or use EMAIL_SKIP_SEND=true locally
AWS_REGION=eu-central-1
FROM_EMAIL=billing@your-domain.com
FROM_NAME="Your Company Billing"
SUPPORT_EMAIL=support@your-domain.com

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@complytude.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
