# ============================================
# API Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=complytude
# Admin/Superuser credentials (for setup and migrations)
DB_USER=postgres
DB_PASSWORD=postgres
# Application user credentials
DB_APP_USER=app_login
DB_APP_PASSWORD=your_secure_password_here
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis (Session Management + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=complytude:

# Session Management
SESSION_MAX_TTL=14d
SESSION_IDLE_TIMEOUT=72h
SESSION_MAX_PER_USER=5
SESSION_ACTIVITY_THROTTLE_SECONDS=120

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production
JWT_REFRESH_HASH_SECRET=your-super-secret-jwt-refresh-hash-key-change-this-in-production
JWT_IDENTITY_SECRET=your-super-secret-jwt-identity-key-change-this-in-production
JWT_IDENTITY_REFRESH_SECRET=your-super-secret-jwt-identity-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d
JWT_IDENTITY_EXPIRES_IN=15m
JWT_IDENTITY_REFRESH_EXPIRES_IN=14d
EMAIL_VERIFICATION_EXPIRES_IN=1d

# MaxMind GeoIP (Optional - disabled if database file not found)
# The .mmdb database file is the ONLY runtime requirement (no license key needed)
# License key is only for downloading the database from MaxMind servers
#
# Setup:
# 1. Create MaxMind account: https://www.maxmind.com/en/geolite2/signup
# 2. Download GeoLite2-City.mmdb (requires license key for download)
# 3. Place file at path below
# 4. Restart app - geolocation will be automatically enabled
#
# For automated updates: Use geoipupdate tool with your license key
# (https://github.com/maxmind/geoipupdate)
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PREFIX=complytude
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=10485760
SIGNED_URL_EXPIRES_IN=900

# MinIO (Docker)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@complytude.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
