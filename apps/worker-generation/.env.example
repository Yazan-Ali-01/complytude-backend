# ============================================
# Worker Generation Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug                  # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=worker-generation   # Identifies this service in structured logs

# Worker Generation Port
WORKER_GENERATION_PORT=3003

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:

# Queue Configuration
WORKER_GENERATION_CONCURRENCY=5
WORKER_GENERATION_MAX_RETRIES=3
WORKER_GENERATION_RETRY_DELAY=5000

# Processing Limits
WORKER_GENERATION_MAX_PROCESSING_TIME=120000

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_APP_USER=postgres
DB_APP_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Gotenberg (PDF conversion)
GOTENBERG_URL=http://localhost:3000

# S3 / Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
COMPLYTUDE_FILES_BUCKET_NAME=complytude-files
TEMPLATES_BUCKET_NAME=complytude-templates
QUARANTINE_BUCKET_NAME=complytude-quarantine
