# ============================================
# Worker Generation Service Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug                  # trace | debug | info | warn | error | fatal | silent
SERVICE_NAME=worker-generation   # Identifies this service in structured logs

# Worker Generation Port
WORKER_GENERATION_PORT=3003

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_TLS=false
REDIS_KEY_PREFIX=complytude:

# Queue Configuration
WORKER_GENERATION_CONCURRENCY=5
WORKER_GENERATION_MAX_RETRIES=3
WORKER_GENERATION_RETRY_DELAY=5000

# Processing Limits
WORKER_GENERATION_MAX_PROCESSING_TIME=120000

# Database Configuration (shared with API)
DB_HOST=localhost
DB_PORT=5432
DB_APP_USER=postgres
DB_APP_PASSWORD=postgres
DB_NAME=complytude
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
# Postgres ends a statement running longer than this, and a transaction left idle this long (ms)
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT=30000
# TLS to the database: required and verified in production. On AWS, DB_SSL_CA_PATH points at the
# Amazon RDS CA bundle baked into the image (/app/certs/rds-global-bundle.pem)
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=

# Gotenberg (PDF conversion)
GOTENBERG_URL=http://localhost:3000

# S3 Storage — For AWS: leave S3_ENDPOINT empty, use IAM roles or set S3_ACCESS_KEY/S3_SECRET_KEY.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
COMPLYTUDE_FILES_BUCKET_NAME=complytude-staging-clean
TEMPLATES_BUCKET_NAME=complytude-staging-clean
QUARANTINE_BUCKET_NAME=complytude-staging-quarantine
MAX_FILE_SIZE=10485760
TEMPLATE_MAX_FILE_SIZE=5242880
SIGNED_URL_EXPIRES_IN=900
