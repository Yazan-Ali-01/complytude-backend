// Complytude Database Schema
// Multi-tenant SaaS platform for UAE legal document generation
// Generated: 2026-03-04

Project Complytude {
  database_type: 'PostgreSQL'
  Note: '''
    # Complytude Database Schema
    Multi-tenant architecture with Row-Level Security (RLS)
    - PostgreSQL 16 with pgvector extension
    - Global reference tables (authorities, categories, templates, rulesets)
    - Tenant-scoped data with RLS (documents, subscriptions, usage, credits)
    - Entitlement engine (plans, features, usage tracking, credit system)
    - Vector tables for RAG compliance analysis (pgvector)
    - Dual-level RBAC (tenant + platform)
    - Version control for templates and rulesets
  '''
}

// ============================================
// ENUMS
// ============================================

Enum template_status {
  active
  inactive
  draft
  deprecated
}

Enum ruleset_status {
  active
  inactive
  deprecated
}

Enum invitation_status {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

Enum feature_type {
  boolean
  quota
  metered
  capacity
  rate_limit
}

Enum subscription_status {
  active
  cancelled
  past_due
  trialing
}

Enum credit_transaction_type {
  purchase
  grant
  deduction
  expiry
  refund
}

Enum usage_source {
  plan
  addon
  credit
  override
}

Enum analysis_job_status {
  queued
  processing
  completed
  failed
}

Enum document_source_type {
  text_input
  file_upload
}

Enum document_extraction_status {
  pending
  processing
  completed
  failed
}

// ============================================
// CORE TABLES (Multi-Tenancy)
// ============================================

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [note: 'Tenant name (NULL for anonymous tenants)']
  logo_url text
  brand_color_primary varchar(7)
  brand_color_secondary varchar(7)
  contact_email varchar(255)
  billing_email varchar(255)
  contact_phone varchar(50)
  emirate varchar(50)
  city varchar(100)
  address_line_1 varchar(500)
  address_line_2 varchar(500)
  postal_code varchar(20)
  trade_license_number varchar(100)
  legal_entity_type varchar(50)
  tax_registration_number varchar(100)
  locale varchar(50) [default: 'en']
  timezone varchar(50)
  default_jurisdiction varchar(100)
  settings jsonb [default: '{}']
  slug varchar(255) [unique]
  is_active boolean [not null, default: true]
  parent_tenant_id uuid [ref: > tenants.id, note: 'Agency/Partner hierarchy (MVP+)']
  onboarding_completed_at timestamptz
  onboarding_metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deactivated_at timestamptz
  deactivation_reason text

  indexes {
    slug
    (is_active)
  }

  Note: '''
    Organizations/companies using the platform.
    Plan is managed via tenant_subscriptions (single source of truth).
  '''
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [null, note: 'NULL for SSO-only until password set']
  first_name varchar(255)
  last_name varchar(255)
  is_verified boolean [not null, default: false]
  platform_role_key varchar(50) [null, note: 'Platform role (e.g., system_admin, support, auditor). NULL for tenant-only users']
  google_id varchar(255) [null, note: 'Google OAuth sub; unique when set']
  microsoft_id varchar(255) [null, note: 'Microsoft OAuth id; unique when set']
  auth_provider varchar(20) [not null, default: 'email', note: 'email | google | microsoft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    User accounts that can access multiple tenants.
    Partial unique indexes (Postgres): google_id, microsoft_id WHERE NOT NULL.
  '''
}

Table user_tenants {
  user_id uuid [pk, not null, ref: > users.id]
  tenant_id uuid [pk, not null, ref: > tenants.id]
  role_key varchar(50) [not null, note: 'Role key (e.g., tenant_admin, legal_counsel, member, viewer)']
  is_active boolean [not null, default: true]
  joined_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    tenant_id
    (tenant_id, is_active)
  }

  Note: '''
    Many-to-many: users can belong to multiple tenants with different roles.
    role_key references system roles or custom roles in tenant_roles table.
  '''
}

// ============================================
// AUTHENTICATION TABLES
// (Refresh/session state lives in Redis; not in PostgreSQL.)
// ============================================

Table email_verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz [null]

  indexes {
    user_id
    token
    expires_at
  }

  Note: 'Email verification tokens sent during signup'
}

Table password_resets {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  used_at timestamptz [null]

  indexes {
    user_id
    token
    expires_at
  }

  Note: 'Password reset tokens for forgot-password flow'
}

Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  tenant_id uuid [not null, ref: > tenants.id]
  token_hash varchar(255) [unique, not null]
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz [not null]
  accepted_at timestamptz [null]
  rejected_at timestamptz [null]
  revoked_at timestamptz [null]
  revoked_by uuid [null, ref: > users.id]
  role varchar(50) [not null, default: 'member']
  status invitation_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    token_hash
    email
    tenant_id
    invited_by
    status
    (email, status)
    (email, tenant_id) [unique, where: 'status = PENDING']
  }

  Note: 'Tenant invitations - users invited to join organizations'
}

// ============================================
// TENANT RBAC TABLES
// ============================================

Table tenant_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(50) [not null]
  name varchar(100) [not null]
  description text
  tenant_id uuid [null, ref: > tenants.id, note: 'NULL for system roles, UUID for custom tenant roles']
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (key, tenant_id) [unique]
    tenant_id
    is_system
  }

  Note: '''
    Tenant roles with support for custom roles (MVP+).
    System roles: tenant_admin, legal_counsel, member, viewer
    Custom roles cannot use reserved system role keys.
  '''
}

Table tenant_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null]
  name varchar(100) [not null]
  resource varchar(50) [not null]
  action varchar(50) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    key
    resource
    (resource, action)
  }

  Note: '''
    Tenant-level permissions for RBAC.
    Format: {resource}:{action}
    Wildcards: documents:*, *:read, *:*
    Synced from TENANT_PERMISSIONS constant on startup.
  '''
}

Table tenant_role_permissions {
  role_id uuid [pk, not null, ref: > tenant_roles.id]
  permission_id uuid [pk, not null, ref: > tenant_permissions.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    role_id
    permission_id
  }

  Note: 'Many-to-many: tenant roles ↔ permissions. System roles use in-memory sets.'
}

// ============================================
// PLATFORM RBAC TABLES
// ============================================

Table platform_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    is_system
  }

  Note: 'Platform-level roles: system_admin, support, auditor'
}

Table platform_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null]
  name varchar(100) [not null]
  resource varchar(50) [not null]
  action varchar(50) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    key
    resource
    (resource, action)
  }

  Note: 'Platform-level permissions. Synced from PLATFORM_PERMISSIONS constant on startup.'
}

Table platform_role_permissions {
  role_id uuid [pk, not null, ref: > platform_roles.id]
  permission_id uuid [pk, not null, ref: > platform_permissions.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    role_id
    permission_id
  }

  Note: 'Many-to-many: platform roles ↔ permissions. System roles use in-memory sets.'
}

// ============================================
// AUDIT TABLES
// ============================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, note: 'NULL for system-level actions']
  user_id uuid [ref: > users.id]
  user_role varchar(50) [note: 'Role key at time of action (historical record)']
  action varchar(100) [not null, note: 'e.g., documents:create, settings:change_jurisdiction']
  resource_type varchar(50)
  resource_id uuid
  details jsonb [default: '{}']
  ai_model_used varchar(100)
  ip_address varchar(45)
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    user_id
    action
    resource_type
    created_at
    (tenant_id, created_at)
  }

  Note: 'Audit trail for all user actions'
}

// ============================================
// GLOBAL REFERENCE TABLES (No RLS)
// ============================================

Table authorities {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null, note: 'e.g., DMCC, IFZA, DIFC']
  name varchar(255) [not null]
  description text
  country varchar(100) [default: 'UAE']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code
    (is_active)
    country
  }

  Note: 'UAE legal authorities (DMCC, IFZA, DED, RAKEZ, etc.)'
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  description text
  parent_id uuid [null, ref: > categories.id]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code
    parent_id
    (is_active)
  }

  Note: 'Template categories with hierarchical support'
}

Table rulesets {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(255) [unique, not null]
  name varchar(255) [not null]
  description text
  authority_id uuid [null, ref: > authorities.id]
  current_version varchar(50) [not null, default: '1.0.0']
  status ruleset_status [not null, default: 'active']
  metadata jsonb [default: '{}']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    authority_id
    status
    created_by
  }

  Note: 'Legal rulesets containing authority-specific clauses and rules'
}

Table ruleset_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  ruleset_id uuid [not null, ref: > rulesets.id]
  version varchar(50) [not null]
  clauses jsonb [not null, default: '[]']
  changelog text
  metadata jsonb [default: '{}']
  is_active boolean [not null, default: true]
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    ruleset_id
    (ruleset_id, version) [unique]
    (is_active)
    created_by
  }

  Note: 'Version history for rulesets - immutable audit trail'
}

Table templates {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(255) [unique, not null]
  name varchar(255) [not null]
  description text
  category_id uuid [null, ref: > categories.id]
  authority_id uuid [null, ref: > authorities.id]
  languages text[] [not null, default: `ARRAY['en']`]
  current_version varchar(50) [not null, default: '1.0.0']
  status template_status [not null, default: 'active']
  file_url text
  thumbnail_url text
  metadata jsonb [default: '{}']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    category_id
    authority_id
    status
    created_by
    languages [type: gin]
  }

  Note: 'Template metadata - main template registry'
}

Table template_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null, ref: > templates.id]
  version varchar(50) [not null]
  fields jsonb [not null, default: '[]']
  file_url text [not null]
  changelog text
  metadata jsonb [default: '{}']
  is_active boolean [not null, default: true]
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    template_id
    (template_id, version) [unique]
    (is_active)
    created_by
  }

  Note: 'Version history for templates - immutable audit trail'
}

// ============================================
// JUNCTION TABLES (Many-to-Many)
// ============================================

Table template_rulesets {
  template_id uuid [pk, not null, ref: > templates.id]
  ruleset_id uuid [pk, not null, ref: > rulesets.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Many-to-many: templates can use multiple rulesets'
}

Table template_version_ruleset_versions {
  template_version_id uuid [pk, not null, ref: > template_versions.id]
  ruleset_version_id uuid [pk, not null, ref: > ruleset_versions.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Many-to-many: tracks which ruleset versions were used in each template version'
}

// ============================================
// ENTITLEMENT SYSTEM - CATALOG (Global, No RLS)
// ============================================

Table features {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null]
  name varchar(255) [not null]
  description text
  feature_type feature_type [not null]
  unit varchar(50) [note: 'e.g., documents, queries, seats']
  creditable boolean [not null, default: false]
  credit_cost integer [note: 'Credits per unit (NULL for non-creditable)']
  is_active boolean [not null, default: true]
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    feature_type
    is_active
  }

  Note: 'Feature catalog. Synced from FEATURE_CATALOG constant on startup.'
}

Table plans {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(50) [unique, not null]
  name varchar(255) [not null]
  description text
  price_monthly decimal(10,2) [not null, default: 0]
  price_currency varchar(3) [not null, default: 'AED']
  billing_period varchar(20) [not null, default: 'monthly']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    is_active
    sort_order
  }

  Note: 'Subscription tier catalog (Navigator, Shield, General Counsel, Infrastructure)'
}

Table plan_entitlements {
  id uuid [pk, default: `gen_random_uuid()`]
  plan_id uuid [not null, ref: > plans.id]
  feature_id uuid [not null, ref: > features.id]
  value_bool boolean
  value_int integer [note: '-1 for unlimited']
  value_text varchar(255) [note: 'For tiered features (essential/full)']
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    plan_id
    feature_id
    (plan_id, feature_id) [unique]
  }

  Note: 'Plan-feature matrix. CHECK constraint: exactly one value field must be set.'
}

Table addons {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null]
  name varchar(255) [not null]
  description text
  price_monthly decimal(10,2) [not null, default: 0]
  price_currency varchar(3) [not null, default: 'AED']
  is_active boolean [not null, default: true]
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    key
    is_active
  }

  Note: 'Add-on catalog for supplemental entitlements'
}

Table addon_entitlements {
  id uuid [pk, default: `gen_random_uuid()`]
  addon_id uuid [not null, ref: > addons.id]
  feature_id uuid [not null, ref: > features.id]
  value_bool boolean
  value_int integer
  value_text varchar(255)
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    addon_id
    feature_id
    (addon_id, feature_id) [unique]
  }

  Note: 'Add-on-feature matrix. CHECK constraint: exactly one value field must be set.'
}

// ============================================
// ENTITLEMENT SYSTEM - TENANT-SCOPED (RLS)
// ============================================

Table tenant_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  plan_id uuid [not null, ref: > plans.id]
  status subscription_status [not null, default: 'active']
  billing_period_start timestamptz [not null]
  billing_period_end timestamptz [not null]
  current_period_start timestamptz [not null]
  current_period_end timestamptz [not null]
  cancelled_at timestamptz
  trial_ends_at timestamptz [note: 'Only set when status = trialing']
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    plan_id
    status
    current_period_end
  }

  Note: '''
    Single source of truth for tenant plan assignment.
    Unique partial index: one active subscription per tenant.
    Resolver reads plan from here (not from tenants table).
  '''
}

Table tenant_addons {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  addon_id uuid [not null, ref: > addons.id]
  quantity integer [not null, default: 1, note: 'Must be > 0']
  status varchar(20) [not null, default: 'active']
  starts_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    addon_id
    status
  }

  Note: 'Tenant add-on subscriptions'
}

Table tenant_overrides {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  feature_id uuid [not null, ref: > features.id]
  value_bool boolean
  value_int integer
  value_text varchar(255)
  reason text [not null]
  applied_by uuid [not null, ref: > users.id]
  starts_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    feature_id
    is_active
    expires_at
  }

  Note: 'Admin overrides for tenant entitlements (highest precedence). CHECK: exactly one value field.'
}

// ============================================
// ENTITLEMENT SYSTEM - EVENT LEDGERS (Append-Only, RLS)
// ============================================

Table usage_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  feature_id uuid [not null, ref: > features.id]
  user_id uuid [ref: > users.id]
  units integer [not null, note: 'Must be > 0']
  billing_period varchar(7) [not null, note: 'YYYY-MM format']
  resource_type varchar(50)
  resource_id uuid
  metadata jsonb [default: '{}']
  idempotency_key varchar(255)
  recorded_at timestamptz [not null, default: `now()`]
  projected_at timestamptz [null, note: 'CAS idempotency guard for async projection. NULL = not yet projected.']

  indexes {
    tenant_id
    feature_id
    billing_period
    (tenant_id, feature_id, billing_period)
    idempotency_key [unique, where: 'idempotency_key IS NOT NULL']
    (recorded_at) [where: 'projected_at IS NULL', note: 'Fast scan for unprojected events']
  }

  Note: '''
    Append-only usage event ledger (immutable source of truth).
    Trigger enforces immutability — only projected_at may be set once (NULL → timestamp).
    projected_at is the CAS guard used by ProjectionUpdateHandler for idempotent projection.
  '''
}

Table usage_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  usage_ledger_id uuid [not null, ref: > usage_ledger.id]
  source usage_source [not null, note: 'plan, addon, credit, override']
  units integer [not null, note: 'Must be > 0']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    usage_ledger_id
    source
  }

  Note: '''
    Source attribution for each usage event.
    Deferrable constraint trigger ensures SUM(units) = usage_ledger.units at commit.
    Immutable (trigger blocks UPDATE/DELETE).
  '''
}

Table credit_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  transaction_type credit_transaction_type [not null]
  amount integer [not null, note: 'Positive for credit, negative for deduction']
  balance_after integer [not null]
  feature_id uuid [ref: > features.id, note: 'Feature ID if deduction']
  usage_ledger_id uuid [ref: > usage_ledger.id, note: 'Link to usage event if deduction']
  reason text
  applied_by varchar(255)
  expires_at timestamptz
  metadata jsonb [default: '{}', note: 'credit_cost_per_unit, units_consumed for deductions']
  idempotency_key varchar(255)
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    transaction_type
    recorded_at
    idempotency_key [unique, where: 'idempotency_key IS NOT NULL']
  }

  Note: '''
    Append-only credit transaction ledger. Immutable (trigger blocks UPDATE/DELETE).
    Deduction metadata includes credit_cost_per_unit and units_consumed.
  '''
}

// ============================================
// ENTITLEMENT SYSTEM - PROJECTIONS & SNAPSHOTS
// ============================================

Table aggregated_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  subscription_id uuid [not null, ref: > tenant_subscriptions.id]
  feature_id uuid [not null, ref: > features.id]
  billing_period varchar(7) [not null]
  total_units integer [not null, default: 0]
  plan_units integer [not null, default: 0]
  addon_units integer [not null, default: 0]
  credit_units integer [not null, default: 0]
  override_units integer [not null, default: 0]
  last_event_id uuid [ref: > usage_ledger.id]
  last_updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    subscription_id
    feature_id
    billing_period
    (tenant_id, subscription_id, feature_id, billing_period) [unique]
  }

  Note: 'Derived projection of usage. Updated async (BullMQ) or via strict CAS near limits. Rebuildable from usage_allocations.'
}

Table entitlement_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  snapshot_data jsonb [not null, note: 'Cached effective entitlements']
  subscription_id uuid [ref: > tenant_subscriptions.id]
  valid_from timestamptz [not null, default: `now()`]
  invalidated_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    valid_from
    invalidated_at
  }

  Note: 'Cached effective entitlements for performance (24h TTL, invalidated on plan/addon/override changes)'
}

// ============================================
// ENTITLEMENT SYSTEM - DOMAIN EVENTS
// ============================================

Table domain_events {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, note: 'NULL for system-wide events']
  event_type varchar(100) [not null, note: 'usage.recorded, credit.deducted, etc.']
  aggregate_type varchar(50) [not null, note: 'usage, credit, subscription, entitlement']
  aggregate_id varchar(255) [not null]
  actor_id varchar(255)
  actor_type varchar(50) [not null, default: 'system']
  payload jsonb [not null]
  metadata jsonb [default: '{}']
  sequence_number bigint
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    event_type
    aggregate_type
    aggregate_id
    recorded_at
    (tenant_id, event_type, recorded_at)
  }

  Note: 'Append-only domain event log for audit trail'
}

// ============================================
// TENANT-SCOPED TABLES (With RLS)
// ============================================

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  title varchar(255) [not null]
  content text
  metadata jsonb [default: '{}']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  // File storage columns
  source_type document_source_type [not null, default: 'text_input', note: 'Distinguish text-pasted docs from file uploads']
  s3_key varchar(1024) [null, note: 'Full S3 object key (includes tenant prefix). NULL for text-input docs']
  s3_bucket varchar(255) [null, note: 'Bucket name (quarantine or clean)']
  original_filename varchar(512) [null, note: 'User original filename for display/download']
  file_size_bytes bigint [null, note: 'File size for validation and display']
  mime_type varchar(255) [null, note: 'e.g. application/pdf']
  extraction_status document_extraction_status [null, note: 'Extraction lifecycle. NULL for text-input docs']
  extraction_error text [null, note: 'Error message if extraction failed']
  extracted_at timestamptz [null, note: 'When text extraction completed']

  indexes {
    tenant_id [note: 'Critical for RLS performance']
    created_by
    (tenant_id, created_at)
    extraction_status [where: 'extraction_status IS NOT NULL']
    s3_key [where: 's3_key IS NOT NULL']
  }

  Note: '''
    Tenant-scoped documents with RLS-based tenant isolation.
    Supports both text-input and file-upload documents.
    RLS: SELECT/INSERT filtered by current_tenant_id_or_null()
    CHECK: text_input requires content; file_upload requires s3_key
  '''
}

// ============================================
// VECTOR / AI TABLES (pgvector)
// ============================================

Table ruleset_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  ruleset_id uuid [not null, ref: > rulesets.id]
  ruleset_version_id uuid [not null, ref: > ruleset_versions.id]
  chunk_index integer [not null]
  content text [not null]
  embedding "vector(1536)" [not null, note: 'OpenAI text-embedding-3-small']
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    ruleset_version_id
    (ruleset_id, ruleset_version_id)
    (ruleset_version_id, chunk_index) [unique]
  }

  Note: '''
    Embedded ruleset clause chunks for vector similarity search (global, no RLS).
    HNSW index on embedding for fast cosine similarity search.
  '''
}

Table analysis_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  document_id uuid [not null, ref: > documents.id]
  created_by uuid [ref: > users.id]
  ruleset_id uuid [ref: > rulesets.id]
  ruleset_version_id uuid [ref: > ruleset_versions.id]
  status analysis_job_status [not null, default: 'queued']
  result jsonb [note: 'Analysis output (matches, violations, recommendations)']
  error text
  started_at timestamptz
  completed_at timestamptz
  failed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    document_id
    status
    (tenant_id, status)
    (tenant_id, created_at)
  }

  Note: 'Compliance analysis job lifecycle (tenant-scoped, RLS)'
}

// ============================================
// TABLE GROUPS (For Visual Organization)
// ============================================

TableGroup "Core Multi-Tenancy" {
  tenants
  users
  user_tenants
}

TableGroup "Tenant RBAC" {
  tenant_roles
  tenant_permissions
  tenant_role_permissions
}

TableGroup "Platform RBAC" {
  platform_roles
  platform_permissions
  platform_role_permissions
}

TableGroup "Authentication" {
  email_verifications
  password_resets
  invitations
}

TableGroup "Audit" {
  audit_logs
}

TableGroup "Entitlements - Catalog (Global)" {
  features
  plans
  plan_entitlements
  addons
  addon_entitlements
}

TableGroup "Entitlements - Tenant (RLS)" {
  tenant_subscriptions
  tenant_addons
  tenant_overrides
}

TableGroup "Entitlements - Event Ledgers (Append-Only)" {
  usage_ledger
  usage_allocations
  credit_ledger
}

TableGroup "Entitlements - Projections & Snapshots" {
  aggregated_usage
  entitlement_snapshots
  domain_events
}

TableGroup "Global Reference Data" {
  authorities
  categories
  rulesets
  ruleset_versions
  templates
  template_versions
}

TableGroup "Junction Tables" {
  template_rulesets
  template_version_ruleset_versions
  tenant_role_permissions
  platform_role_permissions
}

TableGroup "Tenant-Scoped Data (RLS)" {
  documents
}

TableGroup "Vector / AI (pgvector)" {
  ruleset_chunks
  analysis_jobs
}
