// Complytude Database Schema
// Multi-tenant SaaS platform for UAE legal document generation
// Generated: 2026-02-03

Project Complytude {
  database_type: 'PostgreSQL'
  Note: '''
    # Complytude Database Schema
    Multi-tenant architecture with Row-Level Security (RLS)
    - Schema-based tenant isolation
    - Global reference tables (authorities, categories, templates)
    - Tenant-scoped data (documents)
    - Version control for templates and rulesets
  '''
}

// ============================================
// ENUMS
// ============================================

Enum tenant_plan {
  early_access
  basic
  pro
  enterprise
}

// Note: tenant_role is now stored as VARCHAR(50) role_key in user_tenants
// System roles: tenant_admin, legal_counsel, member, viewer
// Custom roles: stored in roles table with tenant_id

Enum template_status {
  active
  inactive
  draft
  deprecated
}

Enum ruleset_status {
  active
  inactive
  deprecated
}

Enum invitation_status {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

// ============================================
// CORE TABLES (Multi-Tenancy & Authentication)
// ============================================

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  plan tenant_plan [not null, note: 'Subscription plan tier']
  features jsonb [not null, default: '{}', note: 'Feature flags and custom features']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    plan
    (is_active) // [where: 'is_active = true']
  }
  
  Note: 'Organizations/companies using the platform'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(255)
  last_name varchar(255)
  is_verified boolean [not null, default: false, note: 'Email verification status']
  platform_role_key varchar(50) [null, note: 'Platform role (e.g., system_admin, support, auditor). NULL for tenant-only users']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  Note: 'User accounts that can access multiple tenants'
}

Table user_tenants {
  user_id uuid [pk, not null, ref: > users.id]
  tenant_id uuid [pk, not null, ref: > tenants.id]
  role_key varchar(50) [not null, note: 'Role key (e.g., tenant_admin, legal_counsel, member, viewer)']
  is_active boolean [not null, default: true]
  joined_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    tenant_id
    (tenant_id, is_active) // [where: 'is_active = true', note: 'RLS optimization']
  }
  
  Note: '''
    Many-to-many: users can belong to multiple tenants with different roles.
    role_key references system roles (tenant_admin, legal_counsel, member, viewer)
    or custom roles defined in the roles table.
  '''
}

// ============================================
// AUTHENTICATION TABLES
// ============================================

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz [null, note: 'NULL if still valid']
  
  indexes {
    user_id
    token_hash
    expires_at
    (revoked_at) // [where: 'revoked_at IS NOT NULL']
  }
  
  Note: 'JWT refresh tokens for session management'
}

Table email_verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz [null, note: 'NULL if not yet verified']
  
  indexes {
    user_id
    token
    expires_at
  }
  
  Note: 'Email verification tokens sent during signup'
}

Table password_resets {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  used_at timestamptz [null, note: 'NULL if not yet used']
  
  indexes {
    user_id
    token
    expires_at
  }
  
  Note: 'Password reset tokens for forgot-password flow'
}

Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  tenant_id uuid [not null, ref: > tenants.id]
  token_hash varchar(255) [unique, not null]
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz [not null]
  accepted_at timestamptz [null, note: 'NULL if not yet accepted']
  rejected_at timestamptz [null, note: 'NULL if not rejected']
  revoked_at timestamptz [null, note: 'NULL if not revoked']
  revoked_by uuid [null, ref: > users.id]
  role varchar(50) [not null, default: 'member', note: 'Role key to assign when accepted']
  status invitation_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    token_hash
    email
    tenant_id
    invited_by
    expires_at
    accepted_at
    status
    (email, status)
    (email, tenant_id) [unique, where: 'status = PENDING', note: 'One pending invitation per email per tenant']
  }
  
  Note: 'Tenant invitations - users invited to join organizations'
}

// ============================================
// RBAC TABLES
// ============================================

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(50) [not null, note: 'Role key (e.g., tenant_admin, legal_counsel)']
  name varchar(100) [not null, note: 'Display name (e.g., Tenant Admin)']
  description text
  tenant_id uuid [null, ref: > tenants.id, note: 'NULL for system roles, UUID for custom tenant roles']
  is_system boolean [not null, default: false, note: 'TRUE for base roles']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    (key, tenant_id) [unique, note: 'Unique role key per tenant (NULL tenant_id for system roles)']
    tenant_id
    is_system
  }
  
  Note: '''
    Tenant roles with support for custom roles (MVP+).
    System roles: tenant_admin, legal_counsel, member, viewer
    Custom roles: tenant-specific with tenant_id set
    Constraint: Custom roles cannot use reserved system role keys
  '''
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null, note: 'Permission key (e.g., documents:create)']
  name varchar(100) [not null, note: 'Display name (e.g., Create Documents)']
  resource varchar(50) [not null, note: 'Resource type (e.g., documents)']
  action varchar(50) [not null, note: 'Action type (e.g., create)']
  description text
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    key
    resource
    (resource, action)
  }
  
  Note: '''
    System permissions for RBAC.
    Format: {resource}:{action}
    Wildcards supported: documents:*, *:read, *:*
    
    Available permissions:
    - documents: create, read, delete
    - contracts: analyze, redline
    - templates: manage, use
    - regulatory: query
    - billing: manage
    - team: manage
    - settings: manage, change_jurisdiction
  '''
}

Table role_permissions {
  role_id uuid [pk, not null, ref: > roles.id]
  permission_id uuid [pk, not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    role_id
    permission_id
  }
  
  Note: '''
    Many-to-many: roles have multiple permissions.
    System roles use in-memory permission sets for performance.
    This table is primarily used for custom tenant roles.
  '''
}

// ============================================
// GLOBAL REFERENCE TABLES (No RLS)
// ============================================

Table authorities {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null, note: 'e.g., DMCC, IFZA, DIFC']
  name varchar(255) [not null]
  description text
  country varchar(100) [default: 'UAE']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    code
    (is_active) // [where: 'is_active = true']
    country
  }
  
  Note: 'UAE legal authorities (DMCC, IFZA, DED, RAKEZ, etc.)'
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  description text
  parent_id uuid [null, ref: > categories.id, note: 'Self-referencing for hierarchy']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    code
    parent_id
    (is_active) // [where: 'is_active = true']
  }
  
  Note: 'Template categories with hierarchical support (employment, corporate, etc.)'
}

Table rulesets {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(255) [unique, not null, note: 'e.g., dmcc_employment_rules_v1']
  name varchar(255) [not null]
  description text
  authority_id uuid [null, ref: > authorities.id]
  current_version varchar(50) [not null, default: '1.0.0']
  status ruleset_status [not null, default: 'active']
  metadata jsonb [default: '{}']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    key
    authority_id
    status
    created_by
  }
  
  Note: 'Legal rulesets containing authority-specific clauses and rules'
}

Table ruleset_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  ruleset_id uuid [not null, ref: > rulesets.id]
  version varchar(50) [not null]
  clauses jsonb [not null, default: '[]', note: 'Array of legal clauses/rules']
  changelog text
  metadata jsonb [default: '{}']
  is_active boolean [not null, default: true]
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    ruleset_id
    version
    (is_active) // [where: 'is_active = true']
    created_by
    (ruleset_id, version) [unique]
  }
  
  Note: 'Version history for rulesets - immutable audit trail'
}

Table templates {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(255) [unique, not null, note: 'e.g., dmcc_employment_v1']
  name varchar(255) [not null]
  description text
  category_id uuid [null, ref: > categories.id]
  authority_id uuid [null, ref: > authorities.id]
  languages text[] [not null, default: `ARRAY['en']`, note: 'en, ar, bilingual']
  current_version varchar(50) [not null, default: '1.0.0']
  status template_status [not null, default: 'active']
  file_url text [note: 'S3 URL to current version DOCX file']
  thumbnail_url text
  metadata jsonb [default: '{}']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    key
    category_id
    authority_id
    status
    created_by
    languages [type: gin]
  }
  
  Note: 'Template metadata - main template registry'
}

Table template_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null, ref: > templates.id]
  version varchar(50) [not null]
  fields jsonb [not null, default: '[]', note: 'Field definitions for this version']
  file_url text [not null, note: 'S3 URL to this version DOCX file']
  changelog text
  metadata jsonb [default: '{}']
  is_active boolean [not null, default: true]
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    template_id
    version
    (is_active) // [where: 'is_active = true']
    created_by
    (template_id, version) [unique]
  }
  
  Note: 'Version history for templates - immutable audit trail'
}

// ============================================
// JUNCTION TABLES (Many-to-Many)
// ============================================

Table template_rulesets {
  template_id uuid [pk, not null, ref: > templates.id]
  ruleset_id uuid [pk, not null, ref: > rulesets.id]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    template_id
    ruleset_id
  }
  
  Note: 'Many-to-many: templates can use multiple rulesets'
}

Table template_version_ruleset_versions {
  template_version_id uuid [pk, not null, ref: > template_versions.id]
  ruleset_version_id uuid [pk, not null, ref: > ruleset_versions.id]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    template_version_id
    ruleset_version_id
  }
  
  Note: 'Many-to-many: tracks which ruleset versions were used in each template version'
}

// ============================================
// ENTITLEMENT SYSTEM TABLES
// ============================================

// Catalog Tables (Global, No RLS)

Table features {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null, note: 'e.g., documents_per_month, redlining_enabled']
  name varchar(255) [not null]
  description text
  feature_type varchar(50) [not null, note: 'boolean, quota, metered, capacity, rate_limit']
  unit varchar(50) [note: 'e.g., documents, queries, seats']
  creditable boolean [not null, default: false, note: 'Can fallback to credits when quota exceeded']
  credit_cost integer [note: 'Cost in credits per unit (NULL for non-creditable features)']
  is_active boolean [not null, default: true]
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    key
    feature_type
    is_active
  }
  
  Note: '''
    Feature catalog defining all available features.
    Synced from code constants on app startup.
    credit_cost: 5 credits for documents_per_month, 3 credits for regulatory_queries_per_month
  '''
}

Table plans {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(50) [unique, not null, note: 'navigator, shield, general_counsel, infrastructure']
  name varchar(255) [not null]
  description text
  price_monthly decimal(10,2) [not null, default: 0]
  price_currency varchar(3) [not null, default: 'AED']
  billing_period varchar(20) [not null, default: 'monthly']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    key
    is_active
    sort_order
  }
  
  Note: 'Subscription tier catalog (Navigator, Shield, General Counsel, Infrastructure)'
}

Table plan_entitlements {
  id uuid [pk, default: `gen_random_uuid()`]
  plan_id uuid [not null, ref: > plans.id]
  feature_id uuid [not null, ref: > features.id]
  value_bool boolean
  value_int integer [note: '-1 for unlimited']
  value_text varchar(255) [note: 'For tiered features like template_library: essential/full']
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    plan_id
    feature_id
    (plan_id, feature_id) [unique]
  }
  
  Note: 'Plan-feature matrix defining what each plan includes'
}

// Tenant-Scoped Tables (With RLS)

Table tenant_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  plan_id uuid [not null, ref: > plans.id]
  status varchar(20) [not null, default: 'active', note: 'active, cancelled, past_due, trialing']
  billing_period_start timestamptz [not null]
  billing_period_end timestamptz [not null]
  current_period_start timestamptz [not null]
  current_period_end timestamptz [not null]
  cancelled_at timestamptz
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    plan_id
    status
    current_period_end
  }
  
  Note: 'Tenant subscription to a plan with billing period tracking'
}

Table tenant_overrides {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  feature_id uuid [not null, ref: > features.id]
  value_bool boolean
  value_int integer
  value_text varchar(255)
  reason text [not null]
  applied_by varchar(255) [not null, note: 'Admin user ID who applied override']
  starts_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    feature_id
    is_active
    expires_at
  }
  
  Note: 'Admin overrides for tenant entitlements (highest precedence)'
}

Table usage_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  feature_id uuid [not null, ref: > features.id]
  user_id uuid [ref: > users.id]
  units integer [not null]
  billing_period varchar(7) [not null, note: 'YYYY-MM format']
  resource_type varchar(50)
  resource_id uuid
  metadata jsonb [default: '{}']
  idempotency_key varchar(255)
  recorded_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    feature_id
    billing_period
    (tenant_id, feature_id, billing_period)
    idempotency_key [unique, where: 'idempotency_key IS NOT NULL']
  }
  
  Note: 'Append-only usage event ledger (source of truth for usage tracking)'
}

Table usage_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  usage_ledger_id uuid [not null, ref: > usage_ledger.id]
  source varchar(20) [not null, note: 'plan, addon, credit, override']
  units integer [not null]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    usage_ledger_id
    source
  }
  
  Note: 'Source attribution for each usage event (which quota/credit was used)'
}

Table aggregated_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  subscription_id uuid [not null, ref: > tenant_subscriptions.id]
  feature_id uuid [not null, ref: > features.id]
  billing_period varchar(7) [not null]
  total_units integer [not null, default: 0]
  plan_units integer [not null, default: 0]
  addon_units integer [not null, default: 0]
  credit_units integer [not null, default: 0]
  override_units integer [not null, default: 0]
  last_event_id uuid [ref: > usage_ledger.id]
  last_updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    subscription_id
    feature_id
    billing_period
    (tenant_id, subscription_id, feature_id, billing_period) [unique]
  }
  
  Note: 'Derived projection of usage (for fast queries, rebuilt from ledger)'
}

Table credit_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  transaction_type varchar(20) [not null, note: 'purchase, grant, deduction, expiry, refund']
  amount integer [not null, note: 'Positive for credit, negative for deduction']
  balance_after integer [not null, note: 'Running balance after this transaction']
  feature_id uuid [ref: > features.id, note: 'Feature ID if deduction']
  usage_ledger_id uuid [ref: > usage_ledger.id, note: 'Link to usage event if deduction']
  reason text
  applied_by varchar(255)
  expires_at timestamptz
  metadata jsonb [default: '{}', note: 'Includes credit_cost_per_unit, units_consumed for deductions']
  idempotency_key varchar(255)
  recorded_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    transaction_type
    recorded_at
    idempotency_key [unique, where: 'idempotency_key IS NOT NULL']
  }
  
  Note: '''
    Append-only credit transaction ledger.
    Metadata for deductions includes:
    - credit_cost_per_unit: Cost per unit (e.g., 5 credits per document)
    - units_consumed: Number of units consumed
  '''
}

Table entitlement_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  snapshot_data jsonb [not null, note: 'Cached effective entitlements']
  subscription_id uuid [ref: > tenant_subscriptions.id]
  valid_from timestamptz [not null, default: `now()`]
  invalidated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    valid_from
    invalidated_at
  }
  
  Note: 'Cached effective entitlements for performance (24h TTL)'
}

Table domain_events {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, note: 'NULL for system-wide events']
  event_type varchar(100) [not null, note: 'usage.recorded, credit.deducted, etc.']
  aggregate_type varchar(50) [not null, note: 'usage, credit, subscription, entitlement']
  aggregate_id varchar(255) [not null]
  actor_id varchar(255)
  actor_type varchar(50) [not null, default: 'system']
  payload jsonb [not null, note: 'Event data including credit_cost_per_unit for credit.deducted']
  metadata jsonb [default: '{}']
  sequence_number bigint
  recorded_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id
    event_type
    aggregate_type
    aggregate_id
    recorded_at
    (tenant_id, event_type, recorded_at)
  }
  
  Note: '''
    Append-only domain event log for audit trail.
    credit.deducted events include credit_cost_per_unit and units_consumed in payload.
  '''
}

// ============================================
// TENANT-SCOPED TABLES (With RLS)
// ============================================

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'RLS isolation key']
  title varchar(255) [not null]
  content text
  metadata jsonb [default: '{}', note: 'Tags, custom fields, etc.']
  template_id uuid [null, ref: > templates.id]
  template_version_id uuid [null, ref: > template_versions.id, note: 'Specific version used']
  generation_metadata jsonb [default: '{}', note: 'AI model, parameters, etc.']
  created_by uuid [null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    tenant_id [note: 'Critical for RLS performance']
    template_id
    template_version_id
    created_by
    (created_at) [type: btree, note: 'DESC order']
    (tenant_id, created_at) [note: 'Composite for tenant queries']
    (tenant_id, template_id)
  }
  
  Note: '''
    Tenant-scoped documents with RLS-based tenant isolation
    RLS Policies:
    - SELECT: tenant_id = current_tenant_id_or_null()
    - INSERT: tenant_id = current_tenant_id_or_null()
  '''
}

// ============================================
// TABLE GROUPS (For Visual Organization)
// ============================================

TableGroup "Core Multi-Tenancy" {
  tenants
  users
  user_tenants
}

TableGroup "RBAC" {
  roles
  permissions
  role_permissions
}

TableGroup "Authentication" {
  refresh_tokens
  email_verifications
  password_resets
  invitations
}

TableGroup "Entitlements - Catalog (Global)" {
  features
  plans
  plan_entitlements
}

TableGroup "Entitlements - Tenant (RLS)" {
