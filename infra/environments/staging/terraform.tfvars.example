# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

aws_region         = "eu-central-1"
environment        = "staging"
project            = "complytude"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"]

# No secret values in this file: Terraform only creates the secret containers. RDS keeps its
# master password in its own secret; put the issued credentials in after the first apply with
#   scripts/deploy/put-app-secrets.sh --env staging   (see docs/DEPLOYMENT.md → Secrets)

# Bastion: reached through SSM Session Manager port forwarding (docs/DEPLOYMENT.md → Connect to
# the Database); no key pair and port 22 closed by default. Only if SSH is really needed:
# bastion_key_name          = "your-key-pair-name"
# bastion_ssh_allowed_cidrs = ["203.0.113.10/32"]  # your IP: curl -s ifconfig.me

# App DB login (its password is in the db-app secret; the Redis AUTH token is generated)
app_db_user = "app_login"

# S3: the tasks use their IAM roles; empty endpoint = AWS S3
s3_endpoint = ""

# CORS — comma-separated origins of the web app (the browser's origin, not the API's)
cors_origins = "https://app-staging.complytude.com"

# The web app's base URL (https): email links and SSO redirects point here
frontend_url = "https://app-staging.complytude.com"

# Stripe account mode: both Stripe keys in the app secret must be this mode's (sk_test_/pk_test_)
stripe_mode = "test"

# ---- Worker AI Configuration ----
worker_ai_concurrency         = 5
worker_ai_max_retries         = 3
worker_ai_retry_delay         = 5000
worker_ai_max_processing_time = 300000

openai_chat_model       = "gpt-4o-mini"
openai_chat_max_tokens  = 4096
openai_chat_temperature = 0.1
openai_chat_timeout     = 120000

openai_embedding_model      = "text-embedding-3-small"
openai_embedding_dimensions = 1536
openai_max_retries          = 3
embedding_chunk_size        = 512
embedding_chunk_overlap     = 50

cohere_rerank_model = "rerank-v3.5"
rerank_top_n        = 25

rag_top_k_per_query    = 5
rag_vector_limit       = 30
rag_bm25_limit         = 30
rag_max_hybrid_results = 40

# ECS — image tag and desired counts
ecs_image_tag                  = "CHANGE_ME_GIT_SHA_OF_A_BUILT_IMAGE"
ecs_api_desired_count          = 1
ecs_worker_ai_desired_count    = 1
ecs_worker_ingestion_desired_count = 1

# Email (AWS SES) — for dunning and notifications
from_email    = "billing@complytude.com"
from_name     = "Complytude Company Billing"
support_email = "support@complytude.com"

# Billing Scheduler — enables daily Stripe reconciliation at 3 AM
billing_schedule_enabled = true

# OAuth2 SSO (optional — leave empty to disable; the client secrets go in the app secret)
# google_client_id     = ""
# google_callback_url  = "https://api-staging.complytude.com/api/v1/auth/google/callback"
# microsoft_client_id     = ""
# microsoft_callback_url  = "https://api-staging.complytude.com/api/v1/auth/microsoft/callback"
# microsoft_tenant_id     = "common"
# sso_frontend_success_path = "/auth/callback"
# sso_frontend_error_path   = "/auth/error"

# Monitoring — email for CloudWatch alarms (must confirm SNS subscription after first apply)
alarm_email = "yazan.ali.dev@gmail.com"
