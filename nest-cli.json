{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/locales/**/*",
            "outDir": "dist/apps/api"
          }
        ],
        "watchAssets": true
      }
    },
    "worker-ingestion": {
      "type": "application",
      "root": "apps/worker-ingestion",
      "entryFile": "main",
      "sourceRoot": "apps/worker-ingestion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-ingestion/tsconfig.app.json"
      }
    },
    "worker-ai": {
      "type": "application",
      "root": "apps/worker-ai",
      "entryFile": "main",
      "sourceRoot": "apps/worker-ai/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-ai/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}
