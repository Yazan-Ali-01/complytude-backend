{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/api"
          }
        ]
      }
    },
    "embedding": {
      "type": "library",
      "root": "libs/embedding",
      "entryFile": "index",
      "sourceRoot": "libs/embedding/src",
      "compilerOptions": {
        "tsConfigPath": "libs/embedding/tsconfig.lib.json"
      }
    },
    "queue": {
      "type": "library",
      "root": "libs/queue",
      "entryFile": "index",
      "sourceRoot": "libs/queue/src",
      "compilerOptions": {
        "tsConfigPath": "libs/queue/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "worker-ai": {
      "type": "application",
      "root": "apps/worker-ai",
      "entryFile": "main",
      "sourceRoot": "apps/worker-ai/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-ai/tsconfig.app.json",
        "assets": []
      }
    },
    "worker-ingestion": {
      "type": "application",
      "root": "apps/worker-ingestion",
      "entryFile": "main",
      "sourceRoot": "apps/worker-ingestion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker-ingestion/tsconfig.app.json",
        "assets": []
      }
    }
  }
}