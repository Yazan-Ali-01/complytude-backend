{
  "name": "complytude",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "// === Quick Start ===": "",
    "project:setup": "bash scripts/first-time-setup.sh",
    "dev": "pnpm start:api:dev",

    "// === Build ===": "",
    "build": "nest build",
    "build:api": "nest build api",
    "build:worker-ingestion": "nest build worker-ingestion",
    "build:worker-ai": "nest build worker-ai",
    "build:shared": "nest build shared",
    "build:all": "pnpm build:shared && pnpm build:api && pnpm build:worker-ingestion && pnpm build:worker-ai",

    "// === Start API ===": "",
    "start": "nest start api",
    "start:api": "nest start api",
    "start:api:dev": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main",

    "// === Start Workers ===": "",
    "start:worker-ingestion": "nest start worker-ingestion",
    "start:worker-ingestion:dev": "nest start worker-ingestion --watch",
    "start:worker-ingestion:prod": "node dist/apps/worker-ingestion/main",
    "start:worker-ai": "nest start worker-ai",
    "start:worker-ai:dev": "nest start worker-ai --watch",
    "start:worker-ai:prod": "node dist/apps/worker-ai/main",

    "// === Docker ===": "",
    "docker:start": "bash scripts/docker-start.sh",
    "docker:up:all": "docker-compose --profile tools up -d",
    "docker:stop": "docker-compose stop",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && pnpm docker:start && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "docker:build": "docker build -t complytude-api:latest .",
    "docker:build:dev": "docker build -t complytude-api:dev --target development .",
    "docker:up:full": "docker-compose --profile full-stack up -d",
    "docker:down:full": "docker-compose --profile full-stack down",
    "docker:logs:app": "docker-compose logs -f app",
    "docker:logs:full": "docker-compose --profile full-stack logs -f",

    "// === Database ===": "",
    "db:setup:roles": "bash scripts/setup-roles.sh",
    "db:migrate": "bash scripts/run-migrations.sh",
    "db:seed": "bash scripts/run-seeds.sh",
    "db:setup": "pnpm docker:start && pnpm db:wait && pnpm db:migrate",
    "db:setup:full": "bash scripts/setup-database.sh",
    "db:wait": "bash scripts/wait-for-db.sh",
    "db:verify": "psql -U postgres -h localhost -p 5432 -d complytude -f scripts/utilities/verify-multi-tenancy.sql",

    "// === Code Quality ===": "",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "type-check": "tsc --noEmit",

    "// === Git Hooks ===": "",
    "prepare": "husky || true",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@aws-sdk/s3-request-presigner": "^3.914.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.7",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.1",
    "fastify": "^5.2.1",
    "file-type": "^21.0.0",
    "joi": "^18.0.1",
    "nestjs-i18n": "^10.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
