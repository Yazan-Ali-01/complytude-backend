    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "@types/ua-parser-js": "^0.7.39",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cohere-ai": "^7.21.0",
    "concurrently": "^9.2.1",
    "docx": "^9.8.1",
