{
  "name": "complytude",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "scripts": {
    "// === 🚀 Quick Start ===": "",
    "project:setup": "bash scripts/first-time-setup.sh",
    "dev": "bash scripts/start-dev.sh",
    "dev:all": "concurrently -n api,worker-ai,worker-ingestion,worker-generation -c cyan,magenta,yellow,green \"pnpm start:api\" \"pnpm start:worker-ai\" \"pnpm start:worker-ingestion\" \"pnpm start:worker-generation\"",
    "// === 🏗️  Build & Start ===": "",
    "build": "nest build api",
    "build:api": "nest build api",
    "build:worker-ai": "nest build worker-ai",
    "build:worker-ingestion": "nest build worker-ingestion",
    "build:worker-generation": "nest build worker-generation",
    "build:all": "pnpm build:api && pnpm build:worker-ai && pnpm build:worker-ingestion && pnpm build:worker-generation",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "start:api": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main",
    "start:worker-ai": "nest start worker-ai --watch",
    "start:worker-ai:debug": "nest start worker-ai --debug --watch",
    "start:worker-ai:prod": "node dist/apps/worker-ai/main",
    "start:worker-ingestion": "nest start worker-ingestion --watch",
    "start:worker-ingestion:debug": "nest start worker-ingestion --debug --watch",
    "start:worker-ingestion:prod": "node dist/apps/worker-ingestion/main",
    "start:worker-generation": "nest start worker-generation --watch",
    "start:worker-generation:debug": "nest start worker-generation --debug --watch",
    "start:worker-generation:prod": "node dist/apps/worker-generation/main",
    "start:all:prod": "concurrently -n api,worker-ai,worker-ingestion,worker-generation \"pnpm start:api:prod\" \"pnpm start:worker-ai:prod\" \"pnpm start:worker-ingestion:prod\" \"pnpm start:worker-generation:prod\"",
    "// === 🐳 Docker (PostgreSQL, Redis, etc.) ===": "",
    "services:up": "docker-compose --profile tools up -d",
    "services:down": "docker-compose down",
    "services:reset": "docker-compose down -v && pnpm services:up && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "// === 🗄️  Database ===": "",
    "db:setup:roles": "bash scripts/setup-roles.sh",
    "db:migrate": "bash scripts/run-migrations.sh",
    "db:seed": "bash scripts/run-seeds.sh",
    "db:generate-chunk-seed": "ts-node scripts/generate-chunk-seed.ts",
    "admin:grant": "nest build api && node dist/apps/api/main.js grant-platform-admin",
    "rulesets:reingest": "nest build api && node dist/apps/api/main.js reingest-rulesets",
    "db:setup": "pnpm services:up && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "db:setup:full": "bash scripts/setup-database.sh",
    "db:wait": "bash scripts/wait-for-db.sh",
    "// === 💳 Stripe ===": "",
    "stripe:sync": "npx ts-node scripts/stripe-catalog-sync.ts",
    "// === 🎨 Code Quality ===": "",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{apps,libs}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "// === 🧪 Tests ===": "",
    "test": "jest",
    "test:unit": "jest --selectProjects unit worker-ingestion-unit worker-ai-unit",
    "test:integration": "jest --selectProjects integration",
    "test:integration:watch": "jest --selectProjects integration --watch",
    "eval:ai": "EVAL_AI=1 jest --selectProjects eval --runInBand",
    "test:ocr-live": "DOCUMENT_INTELLIGENCE_LIVE=1 jest --selectProjects worker-ingestion-unit --testPathPattern=document-intelligence.live",
    "test:benchmark": "jest --selectProjects integration --testPathPattern=benchmark --runInBand --testTimeout=180000",
    "test:coverage": "jest --coverage"
  },
  "ts-node": {
    "// Required for jest.config.ts — root tsconfig uses nodenext which ts-node can't load": "",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
