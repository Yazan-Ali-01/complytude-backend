    "dotenv": "^17.3.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fastify": "^5.11.3",
    "file-type": "^21.3.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
