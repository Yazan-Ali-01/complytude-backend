{
  "name": "complytude",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "// === 🚀 Quick Start ===": "",
    "project:setup": "bash scripts/first-time-setup.sh",
    "dev": "bash scripts/start-dev.sh",
    "dev:all": "concurrently -n api,worker-ai,worker-ingestion -c cyan,magenta,yellow \"pnpm start:api\" \"pnpm start:worker-ai\" \"pnpm start:worker-ingestion\"",
    "// === 🏗️  Build & Start ===": "",
    "build": "nest build api",
    "build:api": "nest build api",
    "build:worker-ai": "nest build worker-ai",
    "build:worker-ingestion": "nest build worker-ingestion",
    "build:all": "pnpm build:api && pnpm build:worker-ai && pnpm build:worker-ingestion",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "start:api": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main",
    "start:worker-ai": "nest start worker-ai --watch",
    "start:worker-ai:debug": "nest start worker-ai --debug --watch",
    "start:worker-ai:prod": "node dist/apps/worker-ai/main",
    "start:worker-ingestion": "nest start worker-ingestion --watch",
    "start:worker-ingestion:debug": "nest start worker-ingestion --debug --watch",
    "start:worker-ingestion:prod": "node dist/apps/worker-ingestion/main",
    "start:all:prod": "concurrently -n api,worker-ai,worker-ingestion \"pnpm start:api:prod\" \"pnpm start:worker-ai:prod\" \"pnpm start:worker-ingestion:prod\"",
    "// === 🧪 Testing ===": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json",
    "test:e2e:watch": "jest --config ./apps/api/test/jest-e2e.json --watch",
    "test:e2e:coverage": "jest --config ./apps/api/test/jest-e2e.json --coverage",
    "test:e2e:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./apps/api/test/jest-e2e.json --runInBand",
    "test:e2e:auth": "jest --config ./apps/api/test/jest-e2e.json 01-authentication",
    "test:e2e:tenant": "jest --config ./apps/api/test/jest-e2e.json 02-multi-tenancy",
    "test:e2e:storage": "jest --config ./apps/api/test/jest-e2e.json 03-storage",
    "test:e2e:templates": "jest --config ./apps/api/test/jest-e2e.json 04-template-management",
    "test:e2e:features": "jest --config ./apps/api/test/jest-e2e.json 05-plan-features",
    "test:swagger": "ts-node apps/api/test/utils/swagger-downloader.ts",
    "test:db:setup": "bash scripts/setup-test-db.sh",
    "test:db:reset": "dropdb -h localhost -U postgres complytude_test --if-exists && pnpm test:db:setup",
    "// === 🐳 Docker Services (PostgreSQL, MinIO) ===": "",
    "docker:start": "bash scripts/docker-start.sh",
    "docker:services": "docker-compose up -d",
    "docker:services:tools": "docker-compose --profile tools up -d",
    "docker:stop": "docker-compose stop",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:logs:minio": "docker-compose logs -f minio",
    "docker:reset": "docker-compose down -v && pnpm docker:start && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "// === 🐳 Docker - API Development ===": "",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml build",
    "docker:dev:up": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml logs -f api",
    "docker:dev:restart": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml restart api",
    "// === 🐳 Docker - API Production ===": "",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:prod:build": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml logs -f api",
    "docker:prod:restart": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml restart api",
    "// === 🗄️  Database ===": "",
    "db:setup:roles": "bash scripts/setup-roles.sh",
    "db:migrate": "bash scripts/run-migrations.sh",
    "db:seed": "bash scripts/run-seeds.sh",
    "db:setup": "pnpm docker:start && pnpm db:wait && pnpm db:migrate",
    "db:setup:full": "bash scripts/setup-database.sh",
    "db:wait": "bash scripts/wait-for-db.sh",
    "// === 🎨 Code Quality ===": "",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@aws-sdk/s3-request-presigner": "^3.914.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "@maxmind/geoip2-node": "^5.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.7",
    "@nestjs/swagger": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.1",
    "fastify": "^5.2.1",
    "file-type": "^21.0.0",
    "ioredis": "^5.9.2",
    "joi": "^18.0.1",
    "nestjs-i18n": "^10.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ua-parser-js": "^2.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@complytude/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
