  "scripts": {
    "// === 🚀 Quick Start ===": "",
    "project:setup": "bash scripts/first-time-setup.sh",
    "dev": "bash scripts/start-dev.sh",
    "dev:all": "concurrently -n api,worker-ai,worker-ingestion -c cyan,magenta,yellow \"pnpm start:api\" \"pnpm start:worker-ai\" \"pnpm start:worker-ingestion\"",
    "// === 🏗️  Build & Start ===": "",
    "build": "nest build api",
    "build:api": "nest build api",
    "build:worker-ai": "nest build worker-ai",
    "build:worker-ingestion": "nest build worker-ingestion",
    "build:all": "pnpm build:api && pnpm build:worker-ai && pnpm build:worker-ingestion",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "start:api": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main",
    "start:worker-ai": "nest start worker-ai --watch",
    "start:worker-ai:debug": "nest start worker-ai --debug --watch",
    "start:worker-ai:prod": "node dist/apps/worker-ai/main",
    "start:worker-ingestion": "nest start worker-ingestion --watch",
    "start:worker-ingestion:debug": "nest start worker-ingestion --debug --watch",
    "start:worker-ingestion:prod": "node dist/apps/worker-ingestion/main",
    "start:all:prod": "concurrently -n api,worker-ai,worker-ingestion \"pnpm start:api:prod\" \"pnpm start:worker-ai:prod\" \"pnpm start:worker-ingestion:prod\"",
    "// === 🐳 Docker Services (PostgreSQL, MinIO) ===": "",
    "docker:start": "bash scripts/docker-start.sh",
    "docker:services": "docker-compose up -d",
    "docker:services:tools": "docker-compose --profile tools up -d",
    "docker:stop": "docker-compose stop",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:logs:minio": "docker-compose logs -f minio",
    "docker:reset": "docker-compose down -v && pnpm docker:start && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "// === 🐳 Docker - API Development ===": "",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml build",
    "docker:dev:up": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml logs -f api",
    "docker:dev:restart": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml restart api",
    "// === 🐳 Docker - API Production ===": "",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:prod:build": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml logs -f api",
    "docker:prod:restart": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml restart api",
    "// === 🗄️  Database ===": "",
    "db:setup:roles": "bash scripts/setup-roles.sh",
    "db:migrate": "bash scripts/run-migrations.sh",
    "db:seed": "bash scripts/run-seeds.sh",
    "db:generate-chunk-seed": "ts-node scripts/generate-chunk-seed.ts",
    "db:setup": "pnpm docker:start && pnpm db:wait && pnpm db:setup:roles && pnpm db:migrate",
    "db:setup:full": "bash scripts/setup-database.sh",
    "db:wait": "bash scripts/wait-for-db.sh",
    "// === 💳 Stripe ===": "",
    "stripe:sync": "npx ts-node scripts/stripe-catalog-sync.ts",
    "// === 🎨 Code Quality ===": "",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "// === 🧪 Tests ===": "",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:integration:watch": "jest --selectProjects integration --watch",
    "test:benchmark": "jest --selectProjects integration --testPathPattern=benchmark --runInBand --testTimeout=180000",
    "test:coverage": "jest --coverage"
  },
  "ts-node": {
    "// Required for jest.config.ts — root tsconfig uses nodenext which ts-node can't load": "",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
